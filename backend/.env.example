NODE_ENV=development
DEPLOYMENT_PLATFORM=local
HOST=127.0.0.1
PORT=4000

# Runtime role. This role must not own tables and must not have BYPASSRLS.
DATABASE_URL=postgresql://yahro_app:CHANGE_ME@127.0.0.1:5432/yahro

# Migration owner. Never use this URL to serve HTTP requests.
DATABASE_MIGRATION_URL=postgresql://yahro_owner:CHANGE_ME@127.0.0.1:5432/yahro
# Used by the Render bootstrap only. Keep it distinct from the owner password.
YAHRO_APP_PASSWORD=CHANGE_ME_DIFFERENT

# At least 64 random characters. Use a different value in every environment.
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
TOKEN_HASH_PEPPER=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
# Generate exactly 32 random bytes and encode them as base64url.
MFA_ENCRYPTION_KEY=CHANGE_ME_BASE64URL_32_BYTES

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_REUSE_GRACE_SECONDS=5
EMAIL_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800

APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_API_ORIGIN=http://127.0.0.1:4000
# Comma-separated proxy IP addresses or CIDR ranges. Leave empty when the API is
# reached directly. Never use a blanket "true" value.
TRUSTED_PROXIES=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Yahro <no-reply@example.invalid>

# Development only. Captured email files contain one-time links.
DEV_EMAIL_CAPTURE_DIR=.dev-mail

LOG_LEVEL=info
MAX_UPLOAD_BYTES=5242880
MAX_CSV_ROWS=10000
