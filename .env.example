# Docker Compose only. Use different random values in every environment.
POSTGRES_DB=yahro
POSTGRES_OWNER_USER=yahro_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME
YAHRO_APP_PASSWORD=CHANGE_ME_DIFFERENT
POSTGRES_PORT=55432

# Production-only browser configuration. Development uses Vite's same-origin
# proxy so the Strict session cookie survives a page refresh.
# Never put a server secret in a VITE_ variable.
VITE_API_URL=http://127.0.0.1:4000
